{
  "name": "monsoon-atlas",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app/main.cjs",
  "scripts": {
    "start": "npm run compile && node desktop/run.mts",
    "dev": "npm start",
    "web": "vite",
    "compile": "vite build --outDir dist/app/web && tsc -p desktop && node desktop/stage.mts",
    "build": "npm run compile && node desktop/package.mts",
    "build:macos": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p desktop --noEmit && tsc -p desktop/tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^5.24.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "~19.1.0",
    "electron": "45.4.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vite": "^8.3.8"
  }
}
